rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One record per keeper, named by their username.
    // Anyone can open a username (that's how username-only sign-in works),
    // but a record must look like a Goldfish save: nothing else can be stored.
    match /players/{name} {
      allow read: if name.matches('^[a-z0-9_]{2,16}$');
      allow create, update: if name.matches('^[a-z0-9_]{2,16}$')
        && request.resource.data.keys().hasOnly(['name', 'level', 'data', 'updated'])
        && request.resource.data.name == name
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 200
        && request.resource.data.data is string
        && request.resource.data.data.size() < 20000
        && request.resource.data.updated is timestamp;
      allow delete: if false;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
