rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One record per keeper, named by their username.
    // Anyone can open a username (that's how username-only sign-in works),
    // but a record must look like a Goldfish save, must come from the current version of the game,
    // and can never go backwards: lifetime xp earned ("total") can't drop, and with the same total,
    // xp spent ("spent") can't drop either (that would undo a purchase). So an old browser tab, or a
    // device holding older progress, can no longer overwrite newer progress.
    match /players/{name} {
      allow read: if name.matches('^[a-z0-9_]{2,16}$');
      allow create: if valid(name);
      allow update: if valid(name) && (
        request.resource.data.total > resource.data.get('total', 0) ||
        (request.resource.data.total == resource.data.get('total', 0) &&
         request.resource.data.get('spent', 0) >= resource.data.get('spent', 0)));
      allow delete: if false;
    }

    function valid(name) {
      let d = request.resource.data;
      return name.matches('^[a-z0-9_]{2,16}$')
        && d.keys().hasOnly(['name', 'level', 'data', 'updated', 'total', 'v', 'spent'])
        && d.keys().hasAll(['name', 'level', 'data', 'updated', 'total', 'v'])
        && d.name == name
        && d.level is int && d.level >= 1 && d.level <= 200
        && d.total is int && d.total >= 0
        && d.v is int && d.v >= 4
        && d.get('spent', 0) is int && d.get('spent', 0) >= 0
        && d.data is string && d.data.size() < 200000
        && d.updated is timestamp;
    }

    // Notifications: each device that turned notifications on leaves its push address here (one document per device).
    // Write-only from the game: nobody can read the addresses back; only the server function that sends the notifications can.
    match /push/{name}/devices/{dev} {
      allow create, update: if name.matches('^[a-z0-9_]{2,16}$') && dev.matches('^[a-z0-9]{4,12}$')
        && request.resource.data.keys().hasOnly(['sub', 'at'])
        && request.resource.data.sub is string && request.resource.data.sub.size() < 2000
        && request.resource.data.at is timestamp;
      allow read, delete: if false;
    }

    // Gift boxes: anyone can leave a small gift for a keeper (a snack, a decoration id, a little fish, or how a duel went).
    // The keeper's game reads the box and clears it after opening the gifts. Gifts can't be edited.
    match /gifts/{to}/box/{id} {
      allow read, delete: if to.matches('^[a-z0-9_]{2,16}$');
      allow create: if to.matches('^[a-z0-9_]{2,16}$')
        && request.resource.data.keys().hasOnly(['from', 'kind', 'item', 'at'])
        && request.resource.data.keys().hasAll(['from', 'kind', 'item', 'at'])
        && request.resource.data.from is string && request.resource.data.from.matches('^[a-z0-9_]{2,16}$')
        && request.resource.data.from != to
        && request.resource.data.kind in ['snack', 'sticker', 'deco', 'fish', 'duel']
        && request.resource.data.item is string && request.resource.data.item.size() <= 24
        && request.resource.data.at is timestamp;
      allow update: if false;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
